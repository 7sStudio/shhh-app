    <string name="automation_sheet_title">Automatisierungs-Intents</string>
    <string name="automation_sheet_body">Jede Automatisierungs-App, die eine Activity starten kann (Tasker, MacroDroid, Routinen), kann Shhh steuern. Starte die Activity io.github.shhhapp.shhh/.ToggleActivity mit einer dieser Aktionen:</string>
    <string name="automation_action_hush">…action.HUSH – sofort leise stellen (optional mit duration_minutes)</string>
    <string name="automation_action_unhush">…action.UNHUSH – Ton wiederherstellen</string>
    <string name="automation_action_toggle">…action.TOGGLE – aktuellen Status umkehren</string>
    <string name="automation_action_media">…action.RESTORE_MEDIA – nur Medienlautstärke</string>

