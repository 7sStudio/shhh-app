    <!-- Automation sheet -->
    <string name="automation_sheet_title">Intents de automação</string>
    <string name="automation_sheet_body">Qualquer app de automação capaz de iniciar uma
        atividade (Tasker, MacroDroid, rotinas) pode controlar o Shhh. Inicie a atividade
        io.github.shhhapp.shhh/.ToggleActivity com uma destas ações:</string>
    <string name="automation_action_hush">…action.HUSH — silenciar agora (extra opcional duration_minutes)</string>
    <string name="automation_action_unhush">…action.UNHUSH — restaurar o som</string>
    <string name="automation_action_toggle">…action.TOGGLE — inverter o estado atual</string>
    <string name="automation_action_media">…action.RESTORE_MEDIA — apenas o volume da mídia</string>

