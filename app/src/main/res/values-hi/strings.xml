    <string name="automation_sheet_title">ऑटोमेशन इंटेंट्स</string>
    <string name="automation_sheet_body">कोई भी ऑटोमेशन ऐप जो एक्टिविटी शुरू कर सकता है (Tasker, MacroDroid, रूटीन) Shhh को कंट्रोल कर सकता है। इनमें से किसी एक एक्शन के साथ io.github.shhhapp.shhh/.ToggleActivity एक्टिविटी शुरू करें:</string>
    <string name="automation_action_hush">…action.HUSH — अभी चुप कराएं (ऑप्शनल एक्स्ट्रा duration_minutes)</string>
    <string name="automation_action_unhush">…action.UNHUSH — साउंड वापस लाएं</string>
    <string name="automation_action_toggle">…action.TOGGLE — मौजूदा स्टेटस बदलें</string>
    <string name="automation_action_media">…action.RESTORE_MEDIA — सिर्फ़ मीडिया वॉल्यूम</string>

