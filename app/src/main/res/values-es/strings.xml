    <!-- Automation sheet -->
    <string name="automation_sheet_title">Intents de automatización</string>
    <string name="automation_sheet_body">Cualquier app de automatización capaz de iniciar
        una actividad (Tasker, MacroDroid, rutinas) puede controlar Shhh. Inicia la
        actividad io.github.shhhapp.shhh/.ToggleActivity con una de estas acciones:</string>
    <string name="automation_action_hush">…action.HUSH — silenciar ahora (extra opcional duration_minutes)</string>
    <string name="automation_action_unhush">…action.UNHUSH — restaurar el sonido</string>
    <string name="automation_action_toggle">…action.TOGGLE — invertir el estado actual</string>
    <string name="automation_action_media">…action.RESTORE_MEDIA — solo volumen multimedia</string>

